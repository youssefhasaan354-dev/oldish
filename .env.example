# Oldish Restaurant & Café — Environment Variables
VITE_DEMO_MODE=false
VITE_SITE_URL=https://oldish-chi.vercel.app

# Firebase Client Configuration (Public / Vercel Client Env)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=oldish-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=oldish-1
VITE_FIREBASE_APP_ID=1:1234567890:web:...

# Firebase Admin Service Account (Server-only / Vercel Server Env — NEVER prefix with VITE_)
# Paste the entire JSON content from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Upstash Redis REST Rate Limiting (Server-only / Vercel Server Env)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary Client Configuration (Public / Vercel Client Env)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary Server Credentials (Server-only / Vercel Server Env — NEVER prefix with VITE_)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Spam Protection (Optional)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Owner Notification (Optional — Server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
OWNER_EMAIL=

# Monitoring & Analytics (Optional — Client)
VITE_SENTRY_DSN=
VITE_VERCEL_ANALYTICS=false
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_API_HOST=https://plausible.io
